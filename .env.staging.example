# Vercel Preview or custom staging environment values.
NEXT_PUBLIC_API_BASE_URL=https://<render-staging-api-host>
AUTH_RATE_LIMITS_ENABLED=true
AUTH_RATE_LIMIT_API_URL=https://<render-staging-api-host>
AUTH_RATE_LIMIT_TOKEN=<same-secret-as-render-api>
NEON_AUTH_BASE_URL=https://<staging-neon-auth-host>/neondb/auth
NEON_AUTH_COOKIE_SECRET=<new-stable-staging-cookie-secret>
